# Reference only: the app reads real environment variables (process.env); it does NOT load .env files.
# Locally, every value below has a working default, so you can run with none of them set.
# On Heroku, set only what you need with `heroku config:set NAME=value`. Placeholders only; never commit real values.

# PORT=8787                      # Heroku sets PORT itself: never set it there
# HOST=127.0.0.1                 # default; on Heroku the app listens on 0.0.0.0 automatically: never set HOST there
# DB_PATH=.data/veilbounty.sqlite

# Optional: use MongoDB instead of SQLite (e.g. MongoDB Atlas when hosting on Heroku). Never commit a real URI.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/veilbounty?retryWrites=true&w=majority
# MONGODB_DB=veilbounty

# Pin the issuer's Ed25519 public key (64 hex). Leave UNSET unless you know the exact key: if unset, the key generated
# by `npm run setup` (at build time on Heroku) is used. A wrong or placeholder value makes every statement fail to verify.
# ISSUER_PUBLIC_KEY=<64-hex-issuer-public-key>

# simulated (default) | manual (operator reports) | zecd (automated testnet payment; funded wallet required)
PAYOUT_ADAPTER=zecd
ZECD_DATADIR=~/.zecd-testnet
ZECD_NETWORK=test
ZECD_BACKEND=zecrocks
ZECD_RPC_BIND=127.0.0.1
ZECD_RPC_PORT=18232
ZECD_RPC_URL=http://127.0.0.1:18232/
ZECD_RPC_USER=zec
# Replace this placeholder and never commit your actual .env file.
ZECD_RPC_PASSWORD=replace-with-your-test-wallet-rpc-password
# ZECD_RPC_TIMEOUT_MS=120000
# KEEPER_POLL_MS=15000
# ZCASH_REQUIRED_CONFIRMATIONS=1
