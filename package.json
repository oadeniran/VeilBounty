{
  "name": "veilbounty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:circuit": "cd circuits/claim && nargo compile && nargo test",
    "vectors": "node scripts/golden-vectors.js",
    "test": "node --no-warnings --test --test-concurrency=1 test/*.test.js",
    "setup": "node scripts/setup.js",
    "init": "npm run setup && npm run build:web",
    "build": "npm run build:circuit && vite build",
    "build:web": "vite build",
    "start": "node --no-warnings src/server/app.js",
    "start:all": "node scripts/start-local.js",
    "keeper": "node --no-warnings scripts/keeper.js",
    "dev": "vite",
    "test:browser": "vite build && node --no-warnings scripts/browser-e2e.js",
    "test:ui": "vite build && node --no-warnings scripts/ui-smoke.js",
    "heroku-postbuild": "npm run setup && npm run build:web"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.1",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/instrument-sans": "5.2.5",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noir-lang/noir_js": "1.0.0-rc.5",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "vite": "6.3.5"
  }
}
